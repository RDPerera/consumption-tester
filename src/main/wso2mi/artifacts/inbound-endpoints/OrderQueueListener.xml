<?xml version="1.0" encoding="UTF-8"?>
<inboundEndpoint xmlns="http://ws.apache.org/ns/synapse"
                 name="OrderQueueListener"
                 sequence="ProcessOrderSequence"
                 onError="RabbitMQErrorSequence"
                 protocol="rabbitmq"
                 suspend="false">
    <parameters>
        <parameter name="sequential">true</parameter>
        <parameter name="coordination">true</parameter>
        
        <!-- RabbitMQ Connection Configuration -->
        <parameter name="rabbitmq.connection.factory">AMQPConnectionFactory</parameter>
        <parameter name="rabbitmq.server.host.name">localhost</parameter>
        <parameter name="rabbitmq.server.port">5672</parameter>
        <parameter name="rabbitmq.server.user.name">guest</parameter>
        <parameter name="rabbitmq.server.password">guest</parameter>
        <parameter name="rabbitmq.server.virtual.host">/</parameter>
        
        <!-- Queue Configuration -->
        <parameter name="rabbitmq.queue.name">orderQueue</parameter>
        <parameter name="rabbitmq.queue.durable">true</parameter>
        <parameter name="rabbitmq.queue.auto.delete">false</parameter>
        <parameter name="rabbitmq.queue.auto.ack">false</parameter>
        <parameter name="rabbitmq.queue.exclusive">false</parameter>
        
        <!-- Consumer Configuration -->
        <parameter name="rabbitmq.consumer.tag">wso2mi-order-consumer</parameter>
        <parameter name="rabbitmq.prefetch.count">10</parameter>
        
        <!-- Connection Pool Settings -->
        <parameter name="rabbitmq.connection.pool.size">25</parameter>
        <parameter name="rabbitmq.connection.retry.interval">10000</parameter>
        <parameter name="rabbitmq.connection.retry.count">5</parameter>
        
        <!-- Content Type -->
        <parameter name="contentType">application/json</parameter>
    </parameters>
</inboundEndpoint>
